{
  "dataset_id": "ocrd_sbb",
  "name": "OCR-D ground truth, historical German prints (gt_structure_text)",
  "track": "historical print",
  "homepage": "https://github.com/OCR-D/gt_structure_text",
  "citation": {
    "note": "Cite the OCR-D ground-truth corpus as given on the repository. Not reproduced here because the DOI and author list have not been verified in this session.",
    "verified": false
  },
  "license": {
    "id": "CC-BY-SA-4.0",
    "redistribution": "allowed",
    "attribution_required": true,
    "share_alike": true,
    "notes": "Read from the GitHub repository metadata for OCR-D/gt_structure_text on 2026-08-18 (license.spdx_id = CC-BY-SA-4.0), replacing the earlier 'unclear-per-volume' placeholder. The corpus aggregates works from several holding libraries, so a publication should still confirm terms per volume; nothing is redistributed here in any case."
  },
  "source": {
    "kind": "github_release",
    "repo": "OCR-D/gt_structure_text",
    "release_tag": "v1.5.0",
    "release_note": "Per-volume OCR-D BagIt zips. Each ships the same PAGE-XML under up to three fileGrp directories; the adapter reads the most granular one only.",
    "survey_note": "67 of the release's 68 volume archives were surveyed on 2026-08-18; witzstat_buchszbaum_1540.ocrd.zip failed to download. It sorts after the selection cutoff (laube_europa0202_1837), so the selection is unaffected -- recorded rather than omitted, because a reader re-running the rule over all 68 must get the same set."
  },
  "selection": {
    "rule": "volumes sorted by identifier, taking whole volumes until the page budget is reached",
    "page_budget": 100,
    "unit": "whole volume",
    "rationale": "Pages of one book share a typeface, a scan session and a binding. Splitting a volume across fit and evaluate would put the same printing on both sides of the document partition, which the image-hash duplicate check cannot see because the pages are genuinely different pages.",
    "fixed_before_results": true
  },
  "recognition": {
    "language": "deu",
    "script": "mixed Fraktur and Antiqua",
    "required_tesseract_languages": [
      "deu",
      "frk"
    ],
    "notes": "Recognizing German Fraktur with an English model produces plausible-looking garbage. The download script fails loudly when the language data is absent."
  },
  "ground_truth": {
    "policy": "ocrd_diplomatic_line",
    "granularity": "line",
    "has_geometry": true,
    "notes": "Diplomatic line transcription preserving historical orthography (long s and similar). A different convention from FUNSD form annotation and CORD receipt annotation; the three tracks are reported separately."
  },
